{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run compile:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(xargs ls:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx eslint src/extension.ts)",
      "Bash(npx tsc:*)",
      "Bash(echo:*)",
      "Bash(chmod:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-plan.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-activity.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-context.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
